#!/usr/bin/env perl
# latexmkrc — build rules for the reqman.sty traceability workflow
#
# Usage:
#   latexmk -pdf sample   # build (reruns automatically as needed)
#   latexmk -c sample     # minimal clean: keep sample.pdf + sample-requirements.json,
#                          # remove every other generated file (csv/aux/log/reqbody/
#                          # reqtables/tracing-report/dot/tikz/etc.)
#   latexmk -C sample     # full clean: also remove sample.pdf and sample-requirements.json
#
# Generated "temporaries" (CSVs, reqbody/reqtables/coverage fragments, the
# tracing report, partial-diagram dot/tikz files) live under $build_dir (see
# below), kept out of the project root alongside the .tex sources, the PDF,
# and <jobname>-requirements.json. To rename the output directory, change
# $build_dir below and \reqmanoutdir{...} in spec-example.tex.
#
# Run from this directory (docs/): `latexmk -pdf spec-example`.

my $build_dir = 'build';

# The project's own package, reqman.sty, lives under tools/ to keep this
# directory focused on the spec sources. Point kpathsea there so
# \usepackage{reqman} resolves; every other package comes from the TeX
# distribution. The trailing empty element ('::') preserves the default
# search path.
$ENV{TEXINPUTS} = 'tools:' . ($ENV{TEXINPUTS} // '') . ':';

# Hand the output dir to the post-processor wrapper below through the
# environment, so that wrapper's shell script can stay fully literal — no Perl
# interpolation and plain single-quote shell quoting (no escaped " or $).
$ENV{REQMAN_BUILD_DIR} = $build_dir;

# Where the spec's links to the IMP markers in the source point (see
# source_url() in tools/reqman-report.py): the repository's source on GitHub
# at REQMAN_SOURCE_REF, the main branch unless set. A release builds with its
# tag (`REQMAN_SOURCE_REF=v0.1.0 latexmk -pdf durable-cache`), so the line
# numbers stay right. `REQMAN_SOURCE_URL=file` links to the building
# checkout's files instead: for local reading only, since it records that
# checkout's absolute path in the PDF.
$ENV{REQMAN_SOURCE_URL} //= 'https://github.com/lmalheiro/durable-cache/blob/'
    . ($ENV{REQMAN_SOURCE_REF} // 'main') . '/{path}#L{line}';

# Extend pdflatex to run the post-processor once per source change.
# -recorder makes pdflatex write <jobname>.fls, which lists every file the
# pass read -- including the build/*.tex fragments reqman-report.py generates.
# The post-processor runs *after* the pdflatex pass inside this wrapper, so
# without the .fls latexmk cannot see that those inputs changed and may stop
# with a PDF built from the previous pass's report; with it, latexmk compares
# their contents and reruns until they settle.
# The done-file guard prevents re-running on every LaTeX pass.
# Triggers: done file absent, main .tex newer, any reqman CSV newer, or
# externals CSV newer — covers edits to included .tex files (which regenerate
# the CSVs without touching the root .tex mtime).
#
# A single-quoted Perl heredoc (<<'SH') wrapping a single-quoted shell script
# (sh -c '...'): nothing is interpolated or escaped on either layer. The
# shell's own $1/${b}/$done survive verbatim, internal double quotes need no
# backslashes, and the output dir comes in via $REQMAN_BUILD_DIR (set above).
$pdflatex = <<'SH';
sh -c '
bd="$REQMAN_BUILD_DIR"
mkdir -p "$bd"
pdflatex --synctex=1 -recorder -interaction=nonstopmode "$1"
b=$(basename "$1" .tex)
done="$bd/${b}-report.done"
need_run=0
[ ! -f "$done" ] && need_run=1
[ "$1" -nt "$done" ] && need_run=1
for csv in "$bd/${b}-artifacts.csv" "$bd/${b}-links.csv" "$bd/${b}-coverage.csv" "$bd/${b}-partial-diagrams.csv" "$bd/${b}-types.csv"; do
    [ -f "$csv" ] && [ "$csv" -nt "$done" ] && need_run=1
done
extlinks="${b}-externals.csv"
[ -f "$extlinks" ] && [ "$extlinks" -nt "$done" ] && need_run=1
if [ "$need_run" -eq 1 ]; then
    python3 tools/reqman-report.py "$b" "$bd"
    touch "$done"
fi
' -- %S
SH

$max_repeat = 5;

# Files removed by `latexmk -c` and `latexmk -C` alike (everything regenerable
# except the final PDF and the requirements.json export -- see $clean_full_ext
# below for those two). All paths below are under $build_dir.

# CSVs written by reqman.sty during compilation
$clean_ext  = "$build_dir/%R-artifacts.csv $build_dir/%R-links.csv $build_dir/%R-coverage.csv $build_dir/%R-partial-diagrams.csv $build_dir/%R-types.csv $build_dir/%R-reqtypes-vocab.csv";

# Per-requirement body files written by reqman.sty during compilation
$clean_ext .= " $build_dir/%R-reqbody-*.tex";

# Files generated by reqman-report.py
$clean_ext .= " $build_dir/%R-tracing-report.tex $build_dir/%R-coverage-*.tex $build_dir/%R-reqtables-*.tex";
$clean_ext .= " $build_dir/%R-partial-*-layout.dot $build_dir/%R-partial-*-tikz.tikz";

# Post-processor guard file
$clean_ext .= " $build_dir/%R-report.done";

# Empty out and remove the now-unused directory itself (same idiom latexmk's
# own docs use for tool-specific output dirs, e.g. pythontex).
$clean_ext .= " $build_dir/* $build_dir";

# Treated like the PDF: kept by `-c` (minimal clean), removed only by `-C`
# (full clean) -- this is the one generated file meant to survive alongside
# the PDF for a coding agent to query (see reqman-context.py). Lives at the
# repo root, not under $build_dir.
$clean_full_ext = '%R-requirements.json';
