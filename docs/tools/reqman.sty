% \reqmanoutdir{DIR}
% Configure a subdirectory (relative to the main .tex file, must already
% exist) where reqman.sty writes its CSV/body files and where it looks for
% reqman-report.py's generated fragments. Call once, right after
% \usepackage{reqman}. Defaults to "" (current directory) if never called.
% Must match the directory latexmkrc creates and passes to reqman-report.py.
\newcommand{\reqman@outdir}{}
\newcommand{\reqmanoutdir}[1]{\renewcommand{\reqman@outdir}{#1}}
\newcommand{\reqman@path}[1]{%
  \ifx\reqman@outdir\@empty
    \jobname-#1%
  \else
    \reqman@outdir/\jobname-#1%
  \fi
}

% \reqmanlabel{sysml-type-name}{friendly display label}
% Defines the LaTeX lookup entry and writes it to the vocab CSV so that
% reqman-report.py can use the same labels in generated diagrams.
% Call after \begin{document} to override a default or add a new stereotype.
\newcommand{\reqmanlabel}[2]{%
  \expandafter\def\csname reqman@label@#1\endcsname{#2}%
  \immediate\write\@reqman@vocabfile{#1,"#2"}%
}

\newcommand{\reqman@friendly@label}[1]{%
  \ifcsname reqman@label@#1\endcsname
    \csname reqman@label@#1\endcsname
  \else
    #1%
  \fi
}

\AtBeginDocument{%
  \immediate\openout\@reqman@artfile=\reqman@path{artifacts.csv}
  \immediate\write\@reqman@artfile{ID,Type,ReqType,Title,Status}
  \immediate\openout\@reqman@depfile=\reqman@path{links.csv}
  \immediate\write\@reqman@depfile{Source_ID,Target_ID,Rel_Type}
  \immediate\openout\@reqman@reqfile=\reqman@path{coverage.csv}
  \immediate\write\@reqman@reqfile{Source_ID,Required_Rel,Required_Prefix,Required_ID,Note}
  \immediate\openout\@reqman@partfile=\reqman@path{partial-diagrams.csv}
  \immediate\write\@reqman@partfile{Label,ShowNeighbors,IDs,MaxPerPart}
  \immediate\openout\@reqman@typefile=\reqman@path{types.csv}
  \immediate\write\@reqman@typefile{Prefix,ReqType,Description,Terminal}
  \immediate\openout\@reqman@vocabfile=\reqman@path{reqtypes-vocab.csv}
  \immediate\write\@reqman@vocabfile{Name,Label}
  % Default stereotype labels — override with \reqmanlabel after this point.
  \reqmanlabel{stakeholderRequirement}{stakeholder requirement}%
  \reqmanlabel{functionalRequirement}{functional requirement}%
  \reqmanlabel{interfaceRequirement}{interface requirement}%
  \reqmanlabel{performanceRequirement}{performance requirement}%
  \reqmanlabel{structuralRequirement}{structural requirement}%
  \reqmanlabel{designConstraint}{design constraint}%
  \reqmanlabel{useCase}{use case}%
  \reqmanlabel{feature}{feature}%
  \reqmanlabel{requirement}{requirement}%
}

